PORT=3003

# Cadena de conexión PostgreSQL
# Local:   postgresql://USUARIO:CLAVE@localhost:5435/inscripciones?schema=public
# AWS RDS: postgresql://USUARIO:CLAVE@<instancia>.<region>.rds.amazonaws.com:5432/inscripciones?schema=public&sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5435/inscripciones?schema=public

# Solo para docker-compose local
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=inscripciones
